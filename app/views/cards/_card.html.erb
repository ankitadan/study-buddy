<div id="<%= dom_id card %>" class="card-item">
  <p>
    <strong>Question:</strong>
    <%= card.question %>
  </p>

  <p>
    <strong>Answer:</strong>
    <%= card.answer %>
  </p>

  <div class="sm2-details">
    Next review:
    <%= card.next_review_date&.to_fs(:review) || "Today" %>
    (interval <%= pluralize(card.interval, "day") %>,
    <%= pluralize(card.repetition, "successful review") %>,
    ease factor <%= card.ease_factor.round(2) %>)
  </div>
</div>
