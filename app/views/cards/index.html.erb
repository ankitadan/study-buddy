<% content_for :title, "Cards" %>

<p><%= link_to "← Back to deck", deck_path(@deck) %></p>

<div class="page-header">
  <h1><%= @deck.name %> Cards</h1>
  <%= link_to "New card", new_deck_card_path(@deck), class: "btn" %>
</div>

<div id="cards">
  <% if @cards.empty? %>
    <p class="empty-state">No cards in this deck yet.</p>
  <% end %>

  <% @cards.each do |card| %>
    <div class="box">
      <%= render card %>

      <div class="actions">
        <%= link_to "Show this card", deck_card_path(@deck, card) %>
        <%= link_to "Edit", edit_deck_card_path(@deck, card) %>
      </div>
    </div>
  <% end %>
</div>
