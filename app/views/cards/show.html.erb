<p style="color: green"><%= notice %></p>

<%= render @card %>

<div>
  <%= link_to "Edit this card",
      edit_deck_card_path(@deck, @card) %>

  <%= link_to "Back to cards",
      deck_cards_path(@deck) %>

  <%= delete_button "Destroy this card", deck_card_path(@deck, @card),
      confirm: "Delete this card?" %>
</div>