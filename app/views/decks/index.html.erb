<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<h1>My Decks</h1>

<div id="decks">
  <% if @decks.empty? %>
    <p>You do not have any decks yet. Create one to start studying.</p>
  <% end %>

  <% @decks.each do |deck| %>
    <div class="deck-summary" id="<%= dom_id deck %>">
      <div class="deck-header">
        <h2><%= deck.name %></h2>

        <%= link_to export_deck_cards_path(deck),
            class: "icon-button",
            download: "",
            title: "Export \"#{deck.name}\" as CSV",
            aria: { label: "Export #{deck.name} as CSV" } do %>
          <%= icon(:download) %>
        <% end %>
      </div>
      <p><%= deck.description %></p>

      <dl class="deck-progress">
        <div>
          <dt>Due today</dt>
          <dd><%= deck.due_cards_count %></dd>
        </div>
        <div>
          <dt>Total reviews</dt>
          <dd><%= deck.reviews_count %></dd>
        </div>
        <div>
          <dt>Study streak</dt>
          <dd><%= pluralize(deck.current_streak, "day") %></dd>
        </div>
      </dl>

      <%= link_to "View Deck", deck_path(deck) %> |
      <%= link_to "Study Due Cards", deck_study_session_path(deck) %> |
      <%= link_to "View Progress", deck_progress_path(deck) %>

      <%= delete_button "Delete Deck", deck_path(deck),
          confirm: "Delete the deck \"#{deck.name}\" and all its cards?" %>
    </div>
  <% end %>
</div>

<div class="deck-actions">
  <%= link_to new_deck_path, class: "icon-button icon-button-labeled" do %>
    <%= icon(:plus) %> Create New Deck
  <% end %>
</div>
