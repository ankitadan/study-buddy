<% content_for :title, "My Decks" %>

<div class="page-header">
  <h1>My Decks</h1>
</div>

<div id="decks">
  <% if @decks.empty? %>
    <p class="empty-state">You do not have any decks yet. Create one to start studying.</p>
  <% end %>

  <% @decks.each do |deck| %>
    <div class="deck-summary" id="<%= dom_id deck %>">
      <div class="deck-header">
        <h2><%= link_to deck.name, deck_path(deck) %></h2>

        <%= link_to export_deck_cards_path(deck),
            class: "icon-button",
            download: "",
            title: "Export \"#{deck.name}\" as CSV",
            aria: { label: "Export #{deck.name} as CSV" } do %>
          <%= icon(:download) %>
        <% end %>
      </div>
      <% if deck.description.present? %>
        <p><%= deck.description %></p>
      <% end %>

      <dl class="deck-progress">
        <div>
          <dt>Due today</dt>
          <dd><%= deck.due_cards_count %></dd>
        </div>
        <div>
          <dt>Total reviews</dt>
          <dd><%= deck.reviews_count %></dd>
        </div>
        <div>
          <dt>Study streak</dt>
          <dd><%= pluralize(deck.current_streak, "day") %></dd>
        </div>
      </dl>

      <div class="actions">
        <%= link_to "Study Due Cards", deck_study_session_path(deck), class: "btn" %>
        <%= link_to "View Deck", deck_path(deck), class: "btn btn-secondary" %>
        <%= link_to "View Progress", deck_progress_path(deck), class: "btn btn-secondary" %>

        <%= delete_button "Delete Deck", deck_path(deck),
            confirm: "Delete the deck \"#{deck.name}\" and all its cards?" %>
      </div>
    </div>
  <% end %>
</div>

<div class="deck-actions">
  <%= link_to new_deck_path, class: "icon-button icon-button-labeled" do %>
    <%= icon(:plus) %> Create New Deck
  <% end %>
</div>
