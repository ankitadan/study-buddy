<h1>Create a New Deck</h1>

<%= form_with model: @deck do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.submit "Create Deck" %>
  </div>
<% end %>

<div class="import-option">
  <p>Or import a deck from a CSV file:</p>
  <%= render "decks/import_form" %>
</div>

<%= link_to "Back to Decks", decks_path %>