<% content_for :title, "Study #{@deck.name}" %>

<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<h1>Study: <%= @deck.name %></h1>

<% if @card %>
  <p class="study-progress">
    <%= pluralize(@remaining_count, "card") %> due
  </p>

  <div class="flashcard">
    <h2>Question</h2>

    <p>
      <%= @card.question %>
    </p>

    <% if @revealed %>
      <hr>

      <h2>Answer</h2>

      <p>
        <%= @card.answer %>
      </p>
    <% end %>
  </div>

  <% if @revealed %>
    <p>How well did you remember this card?</p>

    <div class="rating-buttons">
      <% Card::RATINGS.each_key do |rating| %>
        <%= button_to rating.capitalize,
            review_deck_study_session_path(@deck),
            params: { card_id: @card.id, rating: rating } %>
      <% end %>
    </div>
  <% else %>
    <%= link_to "Show Answer",
        deck_study_session_path(@deck, reveal: true) %>
  <% end %>

<% elsif @summary %>
  <div class="session-summary">
    <h2>🎉 Session complete!</h2>

    <dl class="stat-tiles">
      <div class="stat-tile">
        <dt>Cards reviewed</dt>
        <dd><%= @summary.reviewed_count %></dd>
      </div>
      <div class="stat-tile">
        <dt>Remembered</dt>
        <dd><%= @summary.remembered_percentage %>%</dd>
      </div>
      <div class="stat-tile">
        <dt>Study streak</dt>
        <dd>🔥 <%= pluralize(@summary.progress.current_streak, "day") %></dd>
      </div>
    </dl>

    <ul class="rating-breakdown">
      <% @summary.rating_counts.each do |rating, count| %>
        <li class="rating-<%= rating %>">
          <%= rating.capitalize %>: <strong><%= count %></strong>
        </li>
      <% end %>
    </ul>

    <p>No cards are due for review right now.
      <% if @summary.next_review_date %>
        The next card is due on <%= @summary.next_review_date.to_fs(:review) %>.
      <% end %>
    </p>

    <%= link_to "View Deck Progress", deck_progress_path(@deck) %>
  </div>
<% elsif @deck.cards.any? %>
  <p>No cards are due for review. Great job!</p>
<% else %>
  <p>This deck does not have any cards to study yet.</p>

  <%= link_to "Add Your First Card",
      new_deck_card_path(@deck) %>
<% end %>

<hr>

<%= link_to "Back to Deck", deck_path(@deck) %> |
<%= link_to "Back to My Decks", decks_path %>
